# Copy to .env and fill in. Never commit .env.
# Values here override config/config.yaml. Nested keys use "__", e.g.
# PAPERLENS_LLM__GEMINI__MODELS__EXTRACTION=gemini-3.5-flash

# --- Secrets ---
GEMINI_API_KEY=
GITHUB_TOKEN=
# Optional: Semantic Scholar key (citation graph). It works without one, more slowly.
S2_API_KEY=

# --- Infrastructure (docker-compose sets these for the containers) ---
PAPERLENS_DATABASE_URL=postgresql+psycopg://paperlens:paperlens@localhost:5432/paperlens
PAPERLENS_REDIS_URL=redis://localhost:6379/0
PAPERLENS_GROBID_URL=http://localhost:8070

# --- LLM ---
PAPERLENS_LLM__PRIMARY=gemini

# --- Ingest / pipeline ---
# Contact email for Unpaywall (open-access PDFs for DOIs). Optional.
PAPERLENS_INGEST__CONTACT_EMAIL=
# true = run the pipeline inside the API process (no Redis/Celery needed, e.g. on Windows)
PAPERLENS_PIPELINE__EAGER=false
