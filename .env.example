# Copy to .env and fill in. Never commit .env.
# Values here override config/config.yaml. Nested keys use "__", e.g.
# PAPERLENS_LLM__GEMINI__MODELS__EXTRACTION=gemini-2.5-flash

# --- Secrets ---
GEMINI_API_KEY=
GITHUB_TOKEN=

# --- Infrastructure (docker-compose sets these for the containers) ---
PAPERLENS_DATABASE_URL=postgresql+psycopg://paperlens:paperlens@localhost:5432/paperlens
PAPERLENS_REDIS_URL=redis://localhost:6379/0
PAPERLENS_GROBID_URL=http://localhost:8070

# --- LLM ---
# "gemini" or "ollama". Set to ollama for fully offline mode.
PAPERLENS_LLM__PRIMARY=gemini
# Ollama on the host machine. Inside docker use http://host.docker.internal:11434
PAPERLENS_LLM__OLLAMA__BASE_URL=http://localhost:11434
# Ollama as seen from inside the api/worker containers (docker-compose.yml).
# Use http://ollama:11434 with `docker compose --profile ollama up`.
PAPERLENS_LLM__OLLAMA__BASE_URL_DOCKER=http://host.docker.internal:11434
