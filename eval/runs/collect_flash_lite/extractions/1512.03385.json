       "y1": 277.25
      },
      {
       "page": 3,
       "x0": 91.46,
       "y0": 267.04,
       "x1": 124.39999999999999,
       "y1": 284.33000000000004
      },
      {
       "page": 3,
       "x0": 127.28,
       "y0": 267.29,
       "x1": 135.82,
       "y1": 277.25
      }
     ],
     "quote": "So rather than expect stacked layers to approximate H(x), we explicitly let these layers approximate a residual function F(x) := H(x)x.",
     "grounding_status": "partial",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.1",
   "value": "The building block of the residual network is defined by y = F(x, {Wi}) + x, where x and y are input and output vectors, and F represents the residual mapping learned by stacked layers connected via shortcut connections and element-wise addition.",
   "evidence": [
    {
     "chunk_id": "b0026",
     "page": 3,
     "bbox": {
      "page": 3,
      "x0": 50.11192321777344,
      "y0": 593.4112548828125,
      "x1": 286.36492919921875,
      "y1": 614.2738037109375
     },
     "boxes": [
      {
       "page": 3,
       "x0": 196.3927001953125,
       "y0": 593.4112548828125,
       "x1": 286.36492919921875,
       "y1": 602.3178100585938
      },
      {
       "page": 3,
       "x0": 50.11192321777344,
       "y0": 605.3672485351562,
       "x1": 140.39297485351562,
       "y1": 614.2738037109375
      }
     ],
     "quote": "Formally, in this paper we consider a building block defined as: y = F(x, {W i }) + x.",
     "grounding_status": "verified",
     "match_score": 93.3
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.2",
   "value": "Plain network baselines use 3x3 filters inspired by VGG nets, maintaining equal filter counts for the same feature map sizes and doubling filters when spatial size is halved, ending with global average pooling and a fully-connected softmax layer.",
   "evidence": [
    {
     "chunk_id": "b0035",
     "page": 3,
     "bbox": {
      "page": 3,
      "x0": 308.86,
      "y0": 524.95,
      "x1": 545.11,
      "y1": 557.5
     },
     "boxes": [
      {
       "page": 3,
       "x0": 380.91,
       "y0": 524.95,
       "x1": 545.11,
       "y1": 533.59
      },
      {
       "page": 3,
       "x0": 308.86,
       "y0": 536.9,
       "x1": 545.11,
       "y1": 545.54
      },
      {
       "page": 3,
       "x0": 308.86,
       "y0": 548.86,
       "x1": 327.95,
       "y1": 557.5
      }
     ],
     "quote": "Our plain baselines (Fig. 3, middle) are mainly inspired by the philosophy of VGG nets [41] (Fig. 3, left).",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.3",
   "value": "Residual networks are created by inserting shortcut connections into the plain networks, utilizing either identity mappings with zero padding or projection shortcuts via 1x1 convolutions to handle dimension changes.",
   "evidence": [
    {
     "chunk_id": "b0037",
     "page": 4,
     "bbox": {
      "page": 4,
      "x0": 308.86,
      "y0": 75.48,
      "x1": 545.11,
      "y1": 108.03
     },
     "boxes": [
      {
       "page": 4,
       "x0": 392.02,
       "y0": 75.48,
       "x1": 545.11,
       "y1": 84.12
      },
      {
       "page": 4,
       "x0": 308.86,
       "y0": 87.43,
       "x1": 545.11,
       "y1": 96.07000000000001
      },
      {
       "page": 4,
       "x0": 308.86,
       "y0": 99.39,
       "x1": 490.83000000000004,
       "y1": 108.03
      }
     ],
     "quote": "Based on the above plain network, we insert shortcut connections (Fig. 3, right) which turn the network into its counterpart residual version.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.4",
   "value": "Training is performed from scratch using SGD with mini-batches of 256, batch normalization after convolutions and before activation, weight decay, momentum, and a decaying learning rate schedule.",
