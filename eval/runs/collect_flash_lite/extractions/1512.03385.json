 "method_summary": [
  {
   "id": "method_summary.0",
   "value": "Instead of expecting stacked layers to approximate an underlying mapping H(x), the network is formulated to explicitly approximate a residual function F(x) := H(x) - x, with the original function represented as F(x) + x.",
   "evidence": [
    {
     "chunk_id": "b0021",
