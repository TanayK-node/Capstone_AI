 "method_summary": [
  {
   "id": "method_summary.0",
   "value": "The proposed method uses a low-rank decomposition to represent weight updates, constraining the weight matrix update as W 0 + BA where A and B are trainable low-rank matrices and the original pre-trained weight W 0 is frozen.",
