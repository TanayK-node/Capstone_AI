 "method_summary": [
  {
   "id": "method_summary.0",
   "value": "Instead of joint whitening, each scalar feature is independently normalized to have a mean of zero and a variance of 1 over the training dataset.",
   "evidence": [
    {
     "chunk_id": "b0031",
     "page": 3,
     "bbox": {
      "page": 3,
      "x0": 72.0,
      "y0": 491.68,
      "x1": 301.14,
      "y1": 536.4100000000001
     },
     "boxes": [
      {
       "page": 3,
       "x0": 156.0,
       "y0": 491.68,
       "x1": 301.14,
       "y1": 500.65000000000003
      },
      {
       "page": 3,
       "x0": 72.0,
       "y0": 503.56,
       "x1": 300.97,
       "y1": 512.53
      },
      {
       "page": 3,
       "x0": 72.0,
       "y0": 515.56,
       "x1": 300.97,
       "y1": 524.53
      },
      {
       "page": 3,
       "x0": 72.0,
       "y0": 527.44,
       "x1": 252.45,
       "y1": 536.4100000000001
      }
     ],
     "quote": "The first is that instead of whitening the features in layer inputs and outputs jointly, we will normalize each scalar feature independently, by making it have the mean of zero and the variance of 1.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 1.0,
   "source": "llm"
  },
  {
