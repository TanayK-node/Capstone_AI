  },
  {
   "id": "method_summary.2",
   "value": "Mini-batch statistics are used to estimate the mean and variance during stochastic gradient training, enabling full participation in gradient backpropagation.",
   "evidence": [
    {
     "chunk_id": "b0038",
     "page": 3,
     "bbox": {
