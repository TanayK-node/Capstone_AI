       "page": 1,
       "x0": 62.36,
       "y0": 296.39,
       "x1": 261.23,
       "y1": 305.37
      }
     ],
     "quote": "By training over 400 language models ranging from 70 million to over 16 billion parameters on 5 to 500 billion tokens, we find that for compute-optimal training, the model size and the number of training tokens should be scaled equally: for every doubling of model size the number of training tokens should also be doubled.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.99,
   "source": "llm"
  },
