       "x0": 108.0,
       "y0": 365.41,
       "x1": 243.29,
       "y1": 374.05
      }
     ],
     "quote": "Instead, our proposed encoder-only iTransformer focuses on representation learning and adaptive correlating of multivariate series.",
     "grounding_status": "partial",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "novelty.1",
   "value": "Layer normalization and feed-forward networks are applied to the series representation of individual variates rather than across timestamps to diminish measurement discrepancies.",
