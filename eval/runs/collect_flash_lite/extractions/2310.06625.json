 "novelty": [
  {
   "id": "novelty.0",
   "value": "Unlike typical forecasters treating timestamps as tokens, the proposed iTransformer inverts the architecture to treat each entire time series of a variate as a token.",
   "evidence": [
    {
     "chunk_id": "b0023",
     "page": 4,
     "bbox": {
