       "x1": 138.73000000000002,
       "y1": 288.43
      },
      {
       "page": 4,
       "x0": 138.96,
       "y0": 282.81,
       "x1": 504.21000000000004,
       "y1": 292.77
      }
     ],
     "quote": "The training was regularised by weight decay (the L 2 penalty multiplier set to 5 • 10 -4 ) and dropout regularisation for the first two fully-connected layers (dropout ratio set to 0.5).",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.2",
   "value": "Training is performed via mini-batch gradient descent with momentum by optimizing the multinomial logistic regression objective.",
