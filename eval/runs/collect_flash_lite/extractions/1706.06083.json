 "method_summary": [
  {
   "id": "method_summary.0",
   "value": "The proposed approach models adversarial robustness as a saddle point problem combining an inner maximization problem to find adversarial examples and an outer minimization problem to train robust parameters.",
   "evidence": [
    {
     "chunk_id": "b0021",
     "page": 3,
     "bbox": {
      "page": 3,
      "x0": 72.0,
      "y0": 620.01,
      "x1": 540.4300000000001,
      "y1": 644.4
     },
     "boxes": [
      {
       "page": 3,
       "x0": 72.0,
       "y0": 620.01,
       "x1": 540.4300000000001,
       "y1": 630.85
      },
      {
       "page": 3,
       "x0": 72.0,
       "y0": 633.91,
       "x1": 189.35,
       "y1": 644.4
      }
     ],
     "quote": "Instead of feeding samples from the distribution D directly into the loss L, we allow the adversary to perturb the input first.",
     "grounding_status": "partial",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.1",
   "value": "The inner maximization problem is solved using projected gradient descent (PGD) as a universal first-order adversary to find adversarial examples within the allowed perturbation set.",
   "evidence": [
    {
     "chunk_id": "b0041",
     "page": 5,
     "bbox": {
      "page": 5,
      "x0": 72.0,
      "y0": 567.87,
