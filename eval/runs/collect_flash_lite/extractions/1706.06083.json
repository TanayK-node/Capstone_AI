       "page": 5,
       "x0": 72.0,
       "y0": 581.42,
       "x1": 541.9,
       "y1": 591.91
      }
     ],
     "quote": "The main tool in our experiments is projected gradient descent (PGD), since it is the standard method for large-scale constrained optimization.",
     "grounding_status": "partial",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "method_summary.2",
   "value": "The outer minimization problem is optimized using Stochastic Gradient Descent (SGD) based on gradients computed at the inner maximizers, drawing on Danskin's theorem.",
