       "x0": 108.0,
       "y0": 673.56,
       "x1": 443.29,
       "y1": 682.1999999999999
      }
     ],
     "quote": "We use standard learnable 1D position embeddings, since we have not observed significant performance gains from using more advanced 2D-aware position embeddings (Appendix D.4).",
