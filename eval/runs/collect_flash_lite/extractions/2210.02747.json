 "problem": [
  {
   "id": "problem.0",
   "value": "Existing methods for training Continuous Normalizing Flows lack scalability due to expensive simulations, intractable integrals, or biased gradients.",
   "evidence": [
    {
     "chunk_id": "b0004",
     "page": 1,
     "bbox": {
      "page": 1,
      "x0": 108.0,
      "y0": 574.93,
      "x1": 315.84000000000003,
      "y1": 638.37
     },
     "boxes": [
      {
       "page": 1,
       "x0": 220.71,
       "y0": 574.93,
       "x1": 315.84000000000003,
       "y1": 583.5699999999999
      },
      {
       "page": 1,
       "x0": 108.0,
       "y0": 585.89,
