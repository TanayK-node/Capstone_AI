       "x0": 108.0,
       "y0": 629.73,
       "x1": 233.9,
       "y1": 638.37
      }
     ],
     "quote": "Indeed, maximum likelihood training (e.g., Grathwohl et al. (2018)) require expensive numerical ODE simulations, while existing simulation-free methods either involve intractable integrals (Rozen et al., 2021) or biased gradients (Ben-Hamu et al., 2022).",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "problem.1",
   "value": "Diffusion-based models are restricted to simple diffusion processes, leading to confined sampling paths and long training times.",
   "evidence": [
    {
     "chunk_id": "b0003",
     "page": 1,
     "bbox": {
      "page": 1,
      "x0": 108.0,
      "y0": 459.37,
      "x1": 504.01,
      "y1": 489.91999999999996
     },
     "boxes": [
      {
       "page": 1,
       "x0": 146.44,
       "y0": 459.37,
       "x1": 504.01,
       "y1": 468.01
      },
      {
       "page": 1,
       "x0": 108.0,
       "y0": 470.33,
       "x1": 504.0,
       "y1": 478.96999999999997
      },
      {
       "page": 1,
       "x0": 108.0,
       "y0": 481.28,
       "x1": 429.81,
       "y1": 489.91999999999996
      }
     ],
     "quote": "However, the restriction to simple diffusion processes leads to a rather confined space of sampling probability paths, resulting in very long training times and the need to adopt specialized methods (e.g., Song et al. (2020a); Zhang & Chen (2022)) for efficient sampling.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  }
 ],
 "contributions": [
  {
   "id": "contributions.0",
   "value": "We introduce Flow Matching (FM), a simulation-free approach for training Continuous Normalizing Flows.",
   "evidence": [
    {
     "chunk_id": "b0001",
     "page": 1,
     "bbox": {
      "page": 1,
      "x0": 143.87,
      "y0": 215.29,
      "x1": 468.14,
      "y1": 245.85000000000002
     },
     "boxes": [
      {
       "page": 1,
       "x0": 143.87,
       "y0": 215.29,
       "x1": 468.14,
       "y1": 223.93
      },
      {
       "page": 1,
       "x0": 143.87,
       "y0": 226.25,
       "x1": 468.14,
       "y1": 234.89
      },
      {
       "page": 1,
       "x0": 143.87,
       "y0": 237.21,
       "x1": 213.37,
       "y1": 245.85000000000002
      }
     ],
     "quote": "Specifically, we present the notion of Flow Matching (FM), a simulation-free approach for training CNFs based on regressing vector fields of fixed conditional probability paths.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "contributions.1",
   "value": "We propose the Conditional Flow Matching (CFM) training objective which provides equivalent gradients without requiring knowledge of the target vector field.",
   "evidence": [
    {
     "chunk_id": "b0007",
     "page": 2,
     "bbox": {
      "page": 2,
      "x0": 108.0,
      "y0": 118.22,
      "x1": 504.0,
      "y1": 148.76999999999998
     },
     "boxes": [
      {
       "page": 2,
       "x0": 140.12,
       "y0": 118.22,
       "x1": 504.0,
       "y1": 126.86
      },
      {
       "page": 2,
       "x0": 108.0,
       "y0": 129.17,
       "x1": 504.0,
       "y1": 137.81
      },
      {
       "page": 2,
       "x0": 108.0,
       "y0": 140.13,
       "x1": 321.93,
       "y1": 148.76999999999998
      }
     ],
     "quote": "Then, inspired by denoising score matching, we show that a per-example training objective, termed Conditional Flow Matching (CFM), provides equivalent gradients and does not require explicit knowledge of the intractable target vector field.",
     "grounding_status": "verified",
     "match_score": 100.0
    }
   ],
   "confidence": 0.95,
   "source": "llm"
  },
  {
   "id": "contributions.2",
   "value": "We introduce the use of Optimal Transport displacement interpolation to define conditional probability paths for faster training and sampling.",
