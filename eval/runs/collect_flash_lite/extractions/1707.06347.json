 "contributions": [
  {
   "id": "contributions.0",
   "value": "We propose proximal policy optimization (PPO), a new family of policy gradient methods that enable multiple epochs of minibatch updates and strike a favorable balance between sample complexity, simplicity, and wall-time.",
